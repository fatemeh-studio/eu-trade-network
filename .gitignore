# Data (fetched / built locally, never committed)
data/raw/
data/processed/
data/external/
*.duckdb
*.duckdb.wal

# Secrets
.env

# Local working notes (not published)
plan/

# QA / scratch figures
figures/qa/

# Quarto
# _site/ is the rendered site (CI builds it); .quarto/ is local render scratch.
/_site/
/.quarto/
*_files/

# NOTE: `_freeze/` and `network_viz/` are deliberately COMMITTED (see AGENTS.md /
# README). nbstripout strips outputs from the .ipynb files, so those two directories
# are the only record of the notebook results — CI renders the site from them and
# needs no BACI download. Do not add them here.

